#!/bin/bash
# 该脚本在 Live 构建的 chroot 阶段执行，用于烘焙 DJOS 服务。
set -e
export DEBIAN_FRONTEND=noninteractive
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

mkdir -p /opt/djos /var/lib/djos /var/log/djos /volume1 /etc/djos /etc/exports.d
chmod 755 /opt/djos
chmod 700 /var/lib/djos

install -m 0755 /opt/djos/installer/djos-install /usr/local/sbin/djos-install
install -m 0755 /opt/djos/installer/djos-firstboot /usr/local/sbin/djos-firstboot
install -m 0755 /opt/djos/installer/djos-resetpw /usr/local/sbin/djos-resetpw
install -m 0755 /opt/djos/installer/djos-banner /usr/local/sbin/djos-banner
chmod 0755 /opt/djos/installer/*.sh 2>/dev/null || true
chmod -R a+rX /opt/djos/web /opt/djos/api /opt/djos/packages
chmod 0700 /opt/djos/installer

ln -sf /etc/nginx/sites-available/djos /etc/nginx/sites-enabled/djos
rm -f /etc/nginx/sites-enabled/default

if [ -f /etc/samba/smb.conf ] && ! grep -q 'djos.conf' /etc/samba/smb.conf; then
    sed -i '/^\[global\]/a\   include = /etc/samba/djos.conf' /etc/samba/smb.conf
fi
touch /etc/exports.d/djos.exports
chmod 644 /etc/exports.d/djos.exports

mkdir -p /etc/docker
if [ ! -f /etc/docker/daemon.json ]; then
    cat > /etc/docker/daemon.json <<'EOF'
{
  "data-root": "/volume1/docker",
  "log-driver": "json-file",
  "log-opts": { "max-size": "10m", "max-file": "3" }
}
EOF
fi

systemctl enable djos-api.service djos-firstboot.service djos-installer.service djos-banner.service nginx.service >/dev/null 2>&1 || true
systemctl enable ssh chrony avahi-daemon >/dev/null 2>&1 || true
# 无桌面（headless NAS）：Live 与装好的系统都保持 multi-user.target，
# 由 djos-installer.service 在 tty1 直接进入文本安装器，不再启动图形界面。
systemctl set-default multi-user.target >/dev/null 2>&1 || true

# 让 Live 环境也可直接访问 Web 管理界面（若安装器未运行）
systemctl enable djos-api.service >/dev/null 2>&1 || true

# ============ Live 环境用户与控制台安装器 ============
# 创建 djos 桌面用户
if ! id djos >/dev/null 2>&1; then
    useradd -m -d /home/djos -s /bin/bash djos
fi
echo "djos:djos123" | chpasswd
usermod -aG docker djos
# 仅允许免密执行 DJOS 安装器（最小权限原则）
echo "djos ALL=(root) NOPASSWD: /usr/local/sbin/djos-install" > /etc/sudoers.d/djos-installer
chmod 0440 /etc/sudoers.d/djos-installer

# 无桌面环境：不安装/不配置 lightdm 自动登录、桌面输入法与图形会话。

# Live 开机由 djos-installer.service 直接在 tty1 进入文本安装界面。
# 如需手动重试安装，可在控制台以 djos/djos123 登录后执行 sudo djos-install。

echo "DJOS hook finished"
