#!/usr/bin/env bash
# DJOS 无人值守安装器：从 Live U 盘自动选择系统盘，分区、复制系统、安装引导并重启。
# 设计目标：一次启动即可完成安装，全程无需键盘输入。
set -uo pipefail

LOG="/var/log/djos-install.log"
CONF="/etc/djos/autoinstall.conf"
COUNTDOWN=15
ASSUME_YES=0
TARGET_OVERRIDE="${DJOS_TARGET_DISK:-}"

mkdir -p /var/log/djos
exec > >(tee -a "$LOG") 2>&1

log() { printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*"; }
die() { log "错误：$*"; log "安装已中止，系统未做进一步修改。"; sleep 8; exit 1; }
banner() {
    printf '\n\033[1;36m'
    cat <<'EOF'
  ____     _  ___  ____
 |  _ \   | |/ _ \/ ___|
 | | | |  | | | | \___ \
 | |_| |  | | |_| |___) |
 |____/___|_|\___/|____/
      DJOS NAS 一键安装
EOF
    printf '\033[0m\n'
}

for arg in "$@"; do
    case "$arg" in
        --auto) AUTO=1 ;;
        --yes|-y) ASSUME_YES=1 ;;
        --force) FORCE=1 ;;
        --target=*) TARGET_OVERRIDE="${arg#*=}" ;;
        *) ;;
    esac
done

banner
[ "$(id -u)" -eq 0 ] || die "安装器需要 root 权限"
[ -d /run/live/medium ] || { log "当前不是 DJOS 安装介质，退出。"; exit 0; }

# 已安装检测：若内部磁盘已存在 DJOS 系统分区且未指定 --force，按运行场景处理
# - 交互终端（Live 控制台 tty1 直进安装器）：60 秒倒计时后自动抹盘重装，Ctrl+C 可取消，零输入全自动
# - 服务模式（无 tty）：跳过安装，保护现有系统
# - 显式 --yes：立即抹盘重装（无人值守）
if [ "${FORCE:-0}" -ne 1 ]; then
    EXISTING_SYS=$(blkid -L DJOS_SYSTEM 2>/dev/null || true)
    if [ -n "$EXISTING_SYS" ]; then
        log "检测到已安装的 DJOS 系统分区：$EXISTING_SYS"
        if [ "${ASSUME_YES:-0}" -eq 1 ]; then
            log "--yes 已指定，自动抹盘重装。"
            FORCE=1
        elif [ "${AUTO:-0}" -eq 1 ]; then
            # 服务模式（--auto，systemd 在 tty1 拉起）：发现已有系统即跳过。
            # 避免 VM 中安装介质(CD/ISO)仍挂着、且硬盘引导未接管时，
            # 每次开机都回到 Live 并 60 秒倒计时抹盘重装，形成"反复安装"死循环。
            log "--auto 服务模式：检测到已安装系统，跳过安装（硬盘已装妥，请移除安装介质后重启）。"
            exit 0
        elif [ -t 0 ]; then
            log "60 秒后自动抹除旧系统并重装；按 Ctrl+C 取消并保留现有系统。"
            for i in $(seq 60 -1 1); do
                printf '\r    倒计时 %3d 秒（Ctrl+C 取消） ' "$i"
                sleep 1
            done
            echo
            log "倒计时结束，开始抹盘重装。"
            FORCE=1
        else
            log "无交互终端（服务模式）：跳过安装，现有系统保持不变。"
            exit 0
        fi
    fi
fi

for cmd in parted mkfs.fat mkfs.ext4 mkfs.btrfs rsync grub-install blkid lsblk; do
    command -v "$cmd" >/dev/null 2>&1 || die "缺少安装工具：$cmd"
done

if [ -f "$CONF" ]; then
    # shellcheck disable=SC1090
    . "$CONF"
fi
ADMIN_USER="${DJOS_ADMIN_USER:-admin}"
ADMIN_PASSWORD="${DJOS_ADMIN_PASSWORD:-djos123}"

log "扫描可用磁盘……"
mapfile -t CANDIDATES < <(
    lsblk -bdn -o NAME,TYPE,TRAN,SIZE 2>/dev/null |
        awk '$2=="disk" && $3!="usb" {print $4" "$1}' |
        sort -nr
)

if [ -n "$TARGET_OVERRIDE" ]; then
    TARGET="$TARGET_OVERRIDE"
    log "已通过参数/配置文件指定目标磁盘：$TARGET"
else
    [ "${#CANDIDATES[@]}" -gt 0 ] || die "未找到可安装的内部磁盘（已排除 USB 设备）"
    if [ "${#CANDIDATES[@]}" -eq 1 ]; then
        TARGET="/dev/$(echo "${CANDIDATES[0]}" | awk '{print $2}')"
        log "仅检测到 1 块内部磁盘，自动选择 $TARGET"
    elif [ ! -t 0 ]; then
        # 非交互环境（如 systemd 拉起）退回自动模式：选最大磁盘
        TARGET="/dev/$(echo "${CANDIDATES[0]}" | awk '{print $2}')"
        log "非交互环境，自动选择容量最大的磁盘 $TARGET"
    else
        # 多块内部磁盘：列出候选让用户选择
        log "检测到 ${#CANDIDATES[@]} 块内部磁盘，请选择安装目标："
        printf '\n  序号  设备            容量      型号\n'
        printf '  %s\n' '--------------------------------------------------------------'
        i=1
        for c in "${CANDIDATES[@]}"; do
            sz=$(echo "$c" | awk '{print $1}')
            nm=$(echo "$c" | awk '{print $2}')
            model=$(lsblk -dn -o MODEL "/dev/$nm" 2>/dev/null | tr -s ' ')
            printf '  %2d)   /dev/%-11s %5s GiB  %s\n' "$i" "$nm" "$((sz / 1024 / 1024 / 1024))" "${model:-未知型号}"
            i=$((i + 1))
        done
        printf '\n  请输入序号 [1-%d]，30 秒内无输入则取消安装：' "${#CANDIDATES[@]}"
        if ! read -r -t 30 CHOICE; then
            printf '\n'
            die "未在限定时间内选择磁盘，安装已取消"
        fi
        [[ "$CHOICE" =~ ^[0-9]+$ ]] || die "输入无效：$CHOICE"
        [ "$CHOICE" -ge 1 ] 2>/dev/null && [ "$CHOICE" -le "${#CANDIDATES[@]}" ] || \
            die "序号超出范围：$CHOICE（有效范围 1-${#CANDIDATES[@]}）"
        TARGET="/dev/$(echo "${CANDIDATES[$((CHOICE - 1))]}" | awk '{print $2}')"
        log "已选择目标磁盘：$TARGET"
    fi
fi
[ -b "$TARGET" ] || die "目标磁盘 $TARGET 不存在"

SIZE_BYTES=$(blockdev --getsize64 "$TARGET" 2>/dev/null || echo 0)
SIZE_GIB=$((SIZE_BYTES / 1024 / 1024 / 1024))
[ "$SIZE_BYTES" -ge $((24 * 1024 * 1024 * 1024)) ] || die "磁盘 $TARGET 小于 24GiB，无法安装 DJOS"

DISK_MODEL=$(lsblk -dn -o MODEL "$TARGET" | tr -s ' ')
DISK_SERIAL=$(lsblk -dn -o SERIAL "$TARGET" | tr -s ' ')

cat <<EOF

  目标磁盘 : $TARGET
  型号     : ${DISK_MODEL:-未知}
  序列号   : ${DISK_SERIAL:-未知}
  容量     : ${SIZE_GIB} GiB

  ⚠  警告：安装将清空该磁盘上的全部分区与数据，且不可恢复！
      如需更换目标磁盘，请在 15 秒内按 Ctrl+C 中止，
      或在本 U 盘 /etc/djos/target-disk 写入目标设备路径。

EOF

if [ "$ASSUME_YES" -eq 0 ]; then
    for i in $(seq "$COUNTDOWN" -1 1); do
        printf '\r  安装将在 %2d 秒后自动开始，按 Ctrl+C 取消……' "$i"
        sleep 1
    done
    printf '\r%-70s\r' ''
fi
log "已确认自动安装，开始写入磁盘 $TARGET"

if [ "$SIZE_GIB" -lt 50 ]; then
    ROOT_END="20GiB"
else
    ROOT_END="34GiB"
fi

part() {
    if [[ "$TARGET" =~ /dev/(nvme[0-9]+n[0-9]+|mmcblk[0-9]+)$ ]]; then
        echo "${TARGET}p$1"
    else
        echo "${TARGET}$1"
    fi
}
ESP_PART=$(part 1)
BOOT_PART=$(part 2)
SYS_PART=$(part 3)
DATA_PART=$(part 4)

log "卸载目标磁盘上的所有分区……"
systemctl stop udisks2 2>/dev/null || true
systemctl stop lvm2-monitor 2>/dev/null || true
# 停掉 Live 内的容器运行时：其 overlay 层数据文件不进目标盘，且避免复制期间持续写入
systemctl stop docker.service docker.socket containerd 2>/dev/null || true
swapoff -a 2>/dev/null || true
vgchange -an 2>/dev/null || true
mdadm --stop --scan 2>/dev/null || true
# 暂停 udev 事件队列：擦表期间内核分区刷新（BLKRRPART）会被 udev 的瞬时设备探测打断
udevadm control --stop-exec-queue 2>/dev/null || true
for name in $(lsblk -ln -o NAME "$TARGET" 2>/dev/null | tail -n +2); do
    umount -f "/dev/$name" 2>/dev/null || true
    umount -l "/dev/$name" 2>/dev/null || true
done

log "清除旧分区表……"
WIPE_OK=0
for i in 1 2 3; do
    if wipefs -a "$TARGET" 2>"/tmp/wipefs.err"; then
        WIPE_OK=1
        break
    fi
    log "擦除 $TARGET 被系统拒绝（第 $i/3 次），解除占用后重试……"
    ERRMSG=$(tail -n 2 /tmp/wipefs.err 2>/dev/null | tr '\n' ' ' | tr -s ' ')
    [ -n "$ERRMSG" ] && log "内核报错：$ERRMSG"
    vgchange -an 2>/dev/null || true
    dmsetup remove_all 2>/dev/null || true
    partx -d --nr 1-128 "$TARGET" 2>/dev/null || true
    sleep 2
done

if [ "$WIPE_OK" -ne 1 ]; then
    log "常规擦除仍失败，改用 dd 直接清除磁盘头部签名（绕过内核分区表刷新）……"
    dd if=/dev/zero of="$TARGET" bs=1M count=16 conv=fsync status=none || die "dd 清除 $TARGET 失败，磁盘可能存在硬件级故障"
    partx -d --nr 1-128 "$TARGET" 2>/dev/null || true
    wipefs -a "$TARGET" >/dev/null 2>&1 || true
    log "dd 擦除完成，继续安装。"
fi
udevadm control --start-exec-queue 2>/dev/null || true

log "创建 GPT 分区（ESP / BIOS Boot / 系统 / 数据）……"
parted -s "$TARGET" mklabel gpt || die "写入分区表失败"
parted -s "$TARGET" mkpart ESP fat32 1MiB 513MiB || die "创建 ESP 分区失败"
parted -s "$TARGET" set 1 esp on
parted -s "$TARGET" mkpart BIOSBOOT 513MiB 514MiB || true
parted -s "$TARGET" set 2 bios_grub on || true
parted -s "$TARGET" mkpart DJOS_SYSTEM ext4 514MiB "$ROOT_END" || die "创建系统分区失败"
parted -s "$TARGET" mkpart DJOS_DATA btrfs "$ROOT_END" 100% || die "创建数据分区失败"
partprobe "$TARGET" 2>/dev/null || true
sleep 1

log "格式化分区……"
mkfs.fat -F32 -n DJOS_ESP "$ESP_PART" >/dev/null || die "格式化 ESP 失败"
mkfs.ext4 -F -L DJOS_SYSTEM "$SYS_PART" >/dev/null || die "格式化系统分区失败"
mkfs.btrfs -f -L DJOS_DATA "$DATA_PART" >/dev/null || die "格式化数据分区失败"

log "挂载目标文件系统……"
mkdir -p /target
mount "$SYS_PART" /target || die "挂载系统分区失败"
mkdir -p /target/boot/efi /target/volume1 /target/proc /target/sys /target/dev /target/run /target/tmp
mount "$ESP_PART" /target/boot/efi || die "挂载 ESP 失败"
mount -o compress=zstd:3 "$DATA_PART" /target/volume1 || die "挂载数据分区失败"

log "复制 DJOS 系统文件（约 2-5 分钟）……"
# 排除清单注意：
# - /usr/lib/live/mount 是 live-boot 的挂载点（squashfs 视图 + overlay rw 层），
#   Live 里 Docker 会把 devicemapper 稀疏大文件写进 overlay/rw/volume1/docker，
#   照搬会把目标系统分区瞬间写满（No space left on device），必须整体排除；
# - /var/lib/docker、/var/lib/containerd 是 Live 运行时数据，目标盘由
#   daemon.json 指向 /volume1/docker，首次启动时自动重建。
cat >/tmp/djos-rsync-exclude <<'EOF'
/proc
/sys
/dev
/run
/tmp
/target
/volume1
/boot/efi
/cdrom
/media
/mnt
/live
/usr/lib/live/mount
/var/lib/djos
/var/lib/docker
/var/lib/containerd
/var/log
/var/tmp
/var/cache/apt/archives
/swapfile
EOF
rsync -aHAX --numeric-ids --exclude-from=/tmp/djos-rsync-exclude / /target/ ||
    die "复制系统文件失败"
mkdir -p /target/volume1 /target/boot/efi /target/var/lib/djos /target/var/log/djos

ROOT_UUID=$(blkid -s UUID -o value "$SYS_PART" || true)
ESP_UUID=$(blkid -s UUID -o value "$ESP_PART" || true)
DATA_UUID=$(blkid -s UUID -o value "$DATA_PART" || true)
[ -n "$ROOT_UUID" ] && [ -n "$DATA_UUID" ] || die "无法获取分区 UUID"

cat >/target/etc/fstab <<EOF
# DJOS 自动生成
UUID=$ROOT_UUID  /          ext4   defaults,noatime,errors=remount-ro  0 1
UUID=$ESP_UUID   /boot/efi  vfat   umask=0077                          0 1
UUID=$DATA_UUID  /volume1   btrfs  defaults,noatime,compress=zstd:3    0 0
EOF

for dir in dev proc sys run; do
    mount --bind "/$dir" "/target/$dir" || die "绑定挂载 /$dir 失败"
done
# UEFI 引导安装依赖 EFI 运行时：efivars 通常是以独立子挂载点挂在 /sys/firmware/efi/efivars 上，
# 普通 bind 不会带入子挂载，导致 chroot 内 grub-install(EFI) 探测不到 EFI 变量而失败。
# 这里用 rbind 递归绑定，确保 /sys/firmware/efi/efivars 在 chroot 内可见。
if [ -d /sys/firmware/efi ]; then
    mount --rbind /sys/firmware/efi /target/sys/firmware/efi 2>/dev/null || true
fi

log "配置主机名、账户与系统服务……"
cat >/target/etc/hostname <<EOF
DJOS
EOF
cat >/target/etc/hosts <<EOF
127.0.0.1   localhost
127.0.1.1   DJOS
::1         localhost ip6-localhost ip6-loopback
EOF
rm -f /target/etc/resolv.conf
printf 'nameserver 223.5.5.5\nnameserver 1.1.1.1\n' >/target/etc/resolv.conf

chroot /target /usr/bin/env DJOS_TARGET="$TARGET" \
    DJOS_ADMIN_USER="$ADMIN_USER" DJOS_ADMIN_PASSWORD="$ADMIN_PASSWORD" \
    /bin/bash -e <<'CHROOT'
export DEBIAN_FRONTEND=noninteractive
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# 移除 Live 环境痕迹
userdel -r user >/dev/null 2>&1 || true
apt-get -y purge live-boot live-boot-initramfs-tools live-tools >/dev/null 2>&1 || true
rm -rf /etc/live /lib/live /usr/lib/live 2>/dev/null || true

# 用户与用户组
groupadd -f djos || true
groupadd -f docker || true
if ! id "$DJOS_ADMIN_USER" >/dev/null 2>&1; then
    useradd -m -d "/volume1/home/$DJOS_ADMIN_USER" -s /bin/bash "$DJOS_ADMIN_USER"
fi
usermod -aG djos,sudo,docker "$DJOS_ADMIN_USER" 2>/dev/null || true
echo "$DJOS_ADMIN_USER:$DJOS_ADMIN_PASSWORD" | chpasswd
passwd -u "$DJOS_ADMIN_USER" >/dev/null 2>&1 || true

# 无桌面（headless NAS）：装好的系统保持 multi-user.target，不启动图形界面。
systemctl set-default multi-user.target >/dev/null 2>&1 || true
rm -rf /etc/lightdm /etc/lightdm.conf 2>/dev/null || true

# 系统基础加固：/tmp 权限、主机名解析（修复 sudo 无法解析主机警告）、
# 管理员加入硬件相关组
chmod 1777 /tmp 2>/dev/null || true
chown root:root /tmp 2>/dev/null || true
grep -q "127.0.1.1" /etc/hosts 2>/dev/null || echo "127.0.1.1 DJOS" >> /etc/hosts
usermod -aG video,audio,plugdev "$DJOS_ADMIN_USER" 2>/dev/null || true

mkdir -p /volume1/{public,media,backup,downloads,appdata,docker,home,@snapshots,#recycle}
mkdir -p "/volume1/home/$DJOS_ADMIN_USER"
chown -R "$DJOS_ADMIN_USER:$DJOS_ADMIN_USER" "/volume1/home/$DJOS_ADMIN_USER" 2>/dev/null || true
chmod 2775 /volume1/{public,media,backup,downloads,appdata} 2>/dev/null || true

# Docker 数据目录迁移至数据卷
mkdir -p /etc/docker
cat > /etc/docker/daemon.json <<'EOF'
{
  "data-root": "/volume1/docker",
  "log-driver": "json-file",
  "log-opts": { "max-size": "10m", "max-file": "3" }
}
EOF

# 首次启动初始化服务
chmod +x /usr/local/sbin/djos-firstboot 2>/dev/null || true
systemctl enable djos-firstboot.service >/dev/null 2>&1 || true
systemctl enable djos-api.service nginx.service djos-banner.service >/dev/null 2>&1 || true
for svc in ssh chrony avahi-daemon smbd nmbd nfs-server docker; do
    systemctl enable "$svc" >/dev/null 2>&1 || true
done
systemctl disable djos-installer.service >/dev/null 2>&1 || true
systemctl mask djos-installer.service >/dev/null 2>&1 || true
systemctl disable networking >/dev/null 2>&1 || true
systemctl enable NetworkManager >/dev/null 2>&1 || true

# SSH 安全基线
sed -i 's/^#\?PermitRootLogin .*/PermitRootLogin no/' /etc/ssh/sshd_config 2>/dev/null || true

# 重新生成 initramfs 与 GRUB（引导为强依赖：任一步失败即中止，错误直接输出到安装日志与屏幕）
update-initramfs -u -k all >/dev/null 2>&1 || true

GRUB_CMDLINE_LINUX_DEFAULT="quiet console=tty0"
sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=3/' /etc/default/grub 2>/dev/null || true
grep -q '^GRUB_CMDLINE_LINUX_DEFAULT' /etc/default/grub 2>/dev/null || \
    echo 'GRUB_CMDLINE_LINUX_DEFAULT="quiet console=tty0"' >> /etc/default/grub

# 关键顺序：必须先 grub-install 安装核心镜像（它会创建 /boot/grub 目录及模块），
# 之后 update-grub/grub-mkconfig 才能写入 /boot/grub/grub.cfg.new 并生成 grub.cfg。
# 旧顺序（先 update-grub 后 grub-install）会导致 /boot/grub 目录尚不存在，
# grub-mkconfig 报 "cannot create /boot/grub/grub.cfg.new: Directory nonexistent" 而安装器失败。
echo "==> 安装系统引导（强依赖，失败即中止）……"
mkdir -p /boot/grub
if [ -d /sys/firmware/efi ]; then
    echo "    固件类型：UEFI"
    mkdir -p /boot/efi/EFI/BOOT
    grub-install --target=x86_64-efi --efi-directory=/boot/efi \
        --bootloader-id=DJOS --removable --no-nvram || \
        echo "!! grub-install(EFI) 返回失败，改用 grub-mkstandalone 兜底"
else
    echo "    固件类型：BIOS（Legacy）"
    grub-install --target=i386-pc "$DJOS_TARGET" || { echo "严重：BIOS 引导安装失败"; exit 1; }
    echo "    BIOS 引导就绪：$DJOS_TARGET"
fi

echo "==> 生成 GRUB 配置 /boot/grub/grub.cfg ……"
if ! update-grub; then
    grub-mkconfig -o /boot/grub/grub.cfg || { echo "严重：无法生成 GRUB 配置"; exit 1; }
fi
[ -s /boot/grub/grub.cfg ] || { echo "严重：/boot/grub/grub.cfg 缺失"; exit 1; }

if [ -d /sys/firmware/efi ]; then
    # 兜底：无论 grub-install 是否成功，都确保 UEFI fallback 路径存在可引导文件 BOOTX64.EFI。
    # 虚拟机（OVMF）无 NVRAM 时正是从 \EFI\BOOT\BOOTX64.EFI 引导，缺它才会出现 "Boot0001 Not Found"。
    if [ ! -s /boot/efi/EFI/BOOT/BOOTX64.EFI ]; then
        grub-mkstandalone -O x86_64-efi -o /boot/efi/EFI/BOOT/BOOTX64.EFI \
            --modules="part_gpt part_msdos fat ext2 btrfs normal search search_fs_uuid search_label linux configfile echo gzio efi_gop efi_uga all_video gfxterm gettext boot" \
            "/boot/grub/grub.cfg=/boot/grub/grub.cfg" || \
            { echo "严重：无法生成 EFI 引导文件 BOOTX64.EFI"; exit 1; }
    fi
    [ -s /boot/efi/EFI/BOOT/BOOTX64.EFI ] || { echo "严重：/boot/efi/EFI/BOOT/BOOTX64.EFI 缺失"; exit 1; }
    echo "    EFI 引导就绪：/boot/efi/EFI/BOOT/BOOTX64.EFI"
fi

# 清除唯一标识与日志
truncate -s 0 /etc/machine-id 2>/dev/null || true
rm -f /etc/ssh/ssh_host_* 2>/dev/null || true
rm -f /var/lib/systemd/random-seed 2>/dev/null || true
rm -rf /var/lib/djos/* /var/log/* /var/tmp/* /tmp/* 2>/dev/null || true
mkdir -p /var/lib/djos /var/log/djos
CHROOT

if [ $? -ne 0 ]; then
    die "系统配置阶段失败，请查看 $LOG"
fi

log "同步磁盘并卸载……"
sync
for dir in run sys proc dev; do
    umount -l "/target/$dir" 2>/dev/null || true
done
umount -l /target/volume1 2>/dev/null || true
umount -l /target/boot/efi 2>/dev/null || true
umount -l /target 2>/dev/null || true

LOCAL_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
[ -z "$LOCAL_IP" ] && LOCAL_IP="(DHCP 自动获取中)"

cat <<EOF

  ✅ DJOS 安装完成
  ------------------------------------------------------
  管理地址 : http://${LOCAL_IP}:8800  或 http://djos.local:8800
  初始账户 : $ADMIN_USER
  初始密码 : $ADMIN_PASSWORD
  提示     : 开机后由 DHCP 自动获取 IP，控制台与开机横幅会显示真实地址；
             也可用 http://djos.local:8800 或路由器后台查看。

