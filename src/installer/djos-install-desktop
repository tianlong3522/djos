#!/usr/bin/env bash
# DJOS 桌面安装入口：Live 模式下打开终端运行安装器；已安装系统仅提示。
export DISPLAY="${DISPLAY:-:0.0}"

notify() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "DJOS" "$1" 2>/dev/null || true
    fi
}

if [ ! -d /run/live/medium ]; then
    notify "系统已安装到硬盘，无需再次安装。如需重装请从安装介质启动。"
    sleep 5
    exit 0
fi

if [ ! -x /usr/local/sbin/djos-install ]; then
    notify "未找到安装器 djos-install"
    sleep 5
    exit 1
fi

TERM_BIN=""
for c in xfce4-terminal x-terminal-emulator xterm; do
    command -v "$c" >/dev/null 2>&1 && TERM_BIN="$c" && break
done

if [ -z "$TERM_BIN" ]; then
    notify "未找到终端程序，请改用控制台执行：sudo djos-install"
    sleep 5
    exit 1
fi

case "$TERM_BIN" in
    xfce4-terminal)
        exec "$TERM_BIN" --title="DJOS 安装到硬盘" \
            --command="bash -c 'sudo /usr/local/sbin/djos-install; echo; echo \"---- 已结束，按回车关闭 ----\"; read'"
        ;;
    *)
        exec "$TERM_BIN" -e bash -c 'sudo /usr/local/sbin/djos-install; echo; echo "---- 已结束，按回车关闭 ----"; read'
        ;;
esac
