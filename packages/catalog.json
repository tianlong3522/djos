      "icon": "AG",
      "color": "#67b279",
      "image": "adguard/adguardhome:latest",
      "ports": ["3000:3000", "53:53/tcp", "53:53/udp"],
      "volumes": [
        {"host": "/volume1/appdata/adguard/work", "container": "/opt/adguardhome/work"},
        {"host": "/volume1/appdata/adguard/conf", "container": "/opt/adguardhome/conf"}
      ],
      "env": [],
      "web_port": 3000
    },
    {
      "id": "portainer",
      "name": "Portainer",
      "vendor": "Portainer",
      "category": "工具",
      "tagline": "Docker 图形管理",
      "description": "可视化管理容器、镜像、网络与卷，适合进阶用户。",
      "icon": "PT",
      "color": "#13b5ea",
      "image": "portainer/portainer-ce:latest",
      "ports": ["9443:9443", "9000:9000"],
      "volumes": [
        {"host": "/var/run/docker.sock", "container": "/var/run/docker.sock"},
        {"host": "/volume1/appdata/portainer", "container": "/data"}
      ],
      "env": [],
      "web_port": 9443
    },
    {
      "id": "duplicati",
      "name": "Duplicati",
      "vendor": "Duplicati",
      "category": "备份",
      "tagline": "加密云备份",
      "description": "将 NAS 数据加密备份到对象存储、网盘或另一台服务器。",
      "icon": "DU",
      "color": "#e0245e",
      "image": "linuxserver/duplicati:latest",
      "ports": ["8200:8200"],
      "volumes": [
        {"host": "/volume1/appdata/duplicati", "container": "/config"},
        {"host": "/volume1/backup", "container": "/backups"},
        {"host": "/volume1", "container": "/source", "read_only": true}
      ],
      "env": ["PUID=1000", "PGID=1000", "TZ=Asia/Shanghai"],
      "web_port": 8200
    },
    {
      "id": "navidrome",
      "name": "Navidrome",
      "vendor": "Navidrome",
      "category": "媒体",
      "tagline": "个人音乐流",
