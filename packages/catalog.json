      "icon": "NV",
      "color": "#f59e0b",
      "image": "deluan/navidrome:latest",
      "ports": ["4533:4533"],
      "volumes": [
        {"host": "/volume1/appdata/navidrome", "container": "/data"},
        {"host": "/volume1/media/music", "container": "/music", "read_only": true}
      ],
      "env": ["ND_MUSICFOLDER=/music", "ND_DATAFOLDER=/data"],
      "web_port": 4533
    },
    {
      "id": "minecraft",
      "name": "Minecraft",
      "vendor": "itzg",
      "category": "游戏",
      "tagline": "自建游戏服务器",
      "description": "一键部署 Minecraft Java 版服务器，存档保存在 NAS 上。",
      "icon": "MC",
      "color": "#3c8527",
      "image": "itzg/minecraft-server:latest",
      "ports": ["25565:25565"],
      "volumes": [
        {"host": "/volume1/appdata/minecraft", "container": "/data"}
      ],
      "env": ["EULA=TRUE", "TYPE=PAPER", "MEMORY=2G", "TZ=Asia/Shanghai"],
      "web_port": 0
    }
  ]
}
